prefix=/usr/local/ffmpeg7.1
exec_prefix=${prefix}
libdir=/usr/local/ffmpeg7.1/lib
includedir=/usr/local/ffmpeg7.1/include

Name: libavcodec
Description: FFmpeg codec library
Version: 61.19.100
Requires: 
Requires.private: libswresample >= 5.3.100, libavutil >= 59.39.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm -latomic -lx264 -lx265 -lz
Cflags: -I${includedir}
